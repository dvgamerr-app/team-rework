{
  "name": "tasklist",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "bun x --bun nuxt build",
    "dev": "bun x --bun nuxt dev",
    "generate": "bun x --bun nuxt generate",
    "preview": "bun x --bun nuxt preview",
    "postinstall": "bun x --bun nuxt prepare",
    "lint:js": "bun x --bun eslint ./src",
    "lint:style": "stylelint \"./src/**/*.{css,scss,sass,html,vue}\" --ignore-path .gitignore",
    "lint:prettier": "bun x --bun prettier --check ./src/.",
    "lint": "bun run lint:js && bun run lint:style && bun run lint:prettier",
    "lintfix": "bun x --bun prettier --write --list-different . && bun run lint:js --fix && bun run lint:style --fix",
    "prepare": "bun x --bun husky install"
  },
  "lint-staged": {
    "./src/*.{js,ts,vue}": "eslint --cache",
    "./src/*.{css,scss,sass,html,vue}": "stylelint",
    "./src/*.**": "prettier --check"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "eslint-plugin-prettier": "^5.5.6",
    "entities": "^8.0.0",
    "nuxt": "^4.5.2",
    "primeflex": "^4.0.0",
    "primeicons": "^8.0.0",
    "primevue": "^5.0.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-nuxt": "^4.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  }
}
